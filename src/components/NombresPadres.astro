<!-- ═══════════════════════════════════════════════════════════ --><!-- 👨‍👩‍👧‍👦 SECCIÓN: NUESTROS PADRES                                --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-20 pb-12 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- 📇 CARD DE NUESTROS PADRES -->
        <div class="flex justify-center">
            <div class="relative w-full max-w-5xl" id="card-padres">
                <!-- 🌹 FLORES DECORATIVAS -->
                <img
                    src="/imagenes/rosa2.png"
                    alt="Flores"
                    class="absolute -top-8 -left-6 w-24 sm:w-28 h-auto z-30 pointer-events-none select-none drop-shadow"
                    id="rosa-padres-top"
                />
                <img
                    src="/imagenes/rosa2.png"
                    alt="Flores"
                    class="absolute -bottom-8 -right-6 w-24 sm:w-28 h-auto z-30 pointer-events-none select-none drop-shadow"
                    style="transform: rotate(180deg);"
                    id="rosa-padres-bottom"
                />

                <!-- BOTÓN DECORATIVO SUPERIOR -->
                <div
                    class="absolute z-20"
                    style="top: -30px; left: 50%; transform: translateX(-50%);"
                >
                    <div class="w-16 h-16" id="boton-decorativo">
                        <img
                            src="/imagenes/boton.png"
                            alt="Decoración"
                            class="w-full h-full object-contain"
                        />
                    </div>
                </div>

                <!-- CARD PRINCIPAL -->
                <div
                    class="relative rounded-lg shadow-xl overflow-hidden bg-[#f5f5f5]"
                    id="card-principal"
                    style="border: 2px solid #c8a24c;"
                >
                    <!-- IMAGEN DE FONDO -->
                    <img
                        src="/imagenes/fondoplomo.png"
                        alt="Fondo padres"
                        class="absolute inset-0 w-full h-full object-cover"
                    />

                    <!-- MARCO DORADO INTERIOR FINO -->
                    <div
                        class="absolute inset-2 rounded-md pointer-events-none z-20"
                        style="border: 1px solid rgba(200,162,76,0.6);"
                    >
                    </div>

                    <!-- Contenido de la card -->
                    <div class="relative px-2 pt-14 pb-6 z-10">
                        <!-- TÍTULO PRINCIPAL -->
                        <div class="text-center mb-1">
                            <h2
                                class="font-great-vibes text-[1.9rem] sm:text-[2.1rem] leading-tight text-[#8a0306]"
                                id="titulo-padres"
                            >
                                Con la bendición de mis padres
                            </h2>
                        </div>

                        <!-- SEPARADOR -->
                        <div class="flex items-center justify-center mt-1 mb-3 px-8">
                            <div class="flex-1 h-px bg-[#c8a24c]/50"></div>
                            <div class="mx-4 text-[#c8a24c] text-lg">✦</div>
                            <div class="flex-1 h-px bg-[#c8a24c]/50"></div>
                        </div>

                        <!-- NOMBRES DE LOS PADRES -->
                        <div class="text-center" id="seccion-novia">
                            <p
                                class="font-cormorant-sc text-lg leading-relaxed text-[#8a0306]"
                            >
                                Erwin García Medrano
                                <br />
                                Viviana Castedo Padilla
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            // 🌹 ROSAS ENTRAN SUAVES DESDE LOS COSTADOS
            gsap.fromTo(
                "#rosa-padres-top",
                { opacity: 0, x: -50, y: -10 },
                {
                    opacity: 1, x: 0, y: 0,
                    duration: 1.4, ease: "power2.out", delay: 0.3,
                    scrollTrigger: { trigger: "#card-padres", start: "top 80%", toggleActions: "play none none reset" },
                },
            );
            gsap.fromTo(
                "#rosa-padres-bottom",
                { opacity: 0, x: 50, y: 10, rotation: 180 },
                {
                    opacity: 1, x: 0, y: 0, rotation: 180,
                    duration: 1.4, ease: "power2.out", delay: 0.5,
                    scrollTrigger: { trigger: "#card-padres", start: "top 80%", toggleActions: "play none none reset" },
                },
            );

            // 🎯 ANIMACIÓN ELEGANTE DE ENTRADA
            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: "#card-padres",
                    start: "top 80%",
                    toggleActions: "play none none reset",
                },
            });

            // Todos los elementos entran al mismo tiempo con diferentes efectos
            tl.fromTo(
                "#boton-decorativo",
                {
                    opacity: 0,
                    scale: 0,
                    rotation: -180,
                },
                {
                    opacity: 1,
                    scale: 1,
                    rotation: 0,
                    duration: 1,
                    ease: "back.out(1.7)",
                },
                0, // Empieza en el tiempo 0
            )
                .fromTo(
                    "#card-principal",
                    {
                        opacity: 0,
                        y: 50,
                        scale: 0.95,
                    },
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1,
                        ease: "power3.out",
                    },
                    0, // Empieza en el tiempo 0
                )
                .fromTo(
                    "#titulo-padres",
                    {
                        opacity: 0,
                        y: -30,
                    },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 1,
                        ease: "power2.out",
                    },
                    0, // Empieza en el tiempo 0
                )
                .fromTo(
                    "#seccion-novia",
                    {
                        opacity: 0,
                        x: -30,
                    },
                    {
                        opacity: 1,
                        x: 0,
                        duration: 1,
                        ease: "power2.out",
                    },
                    0, // Empieza en el tiempo 0
                )
                .fromTo(
                    "#seccion-novio",
                    {
                        opacity: 0,
                        x: 30,
                    },
                    {
                        opacity: 1,
                        x: 0,
                        duration: 1,
                        ease: "power2.out",
                    },
                    0, // Empieza en el tiempo 0
                );
        });
    }
</script>

<style>
    /* Aseguramos que Cormorant SC esté disponible */
    .font-cormorant-sc {
        font-family: "Cormorant SC", serif;
    }
</style>
