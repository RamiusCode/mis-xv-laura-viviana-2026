<!-- ═══════════════════════════════════════════════════════════ --><!-- 🎁 SECCIÓN: SUGERENCIA DE REGALES                           --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full py-16 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- 📇 CARD DE MESA DE REGALOS -->
        <div class="flex justify-center">
            <div class="relative w-[300px]" id="card-regalos">
                <!-- 🌹 FLORES DECORATIVAS -->
                <img
                    src="/imagenes/rosa2.png"
                    alt="Flores"
                    class="absolute -top-8 -left-8 w-28 sm:w-32 h-auto z-30 pointer-events-none select-none drop-shadow"
                    id="rosa-regalos-top"
                />
                <img
                    src="/imagenes/rosa2.png"
                    alt="Flores"
                    class="absolute -bottom-8 -right-8 w-28 sm:w-32 h-auto z-30 pointer-events-none select-none drop-shadow"
                    style="transform: rotate(180deg);"
                    id="rosa-regalos-bottom"
                />

                <!-- BOTÓN DECORATIVO SUPERIOR -->
                <div
                    class="absolute z-20"
                    style="top: -30px; left: 50%; transform: translateX(-50%);"
                >
                    <div class="w-16 h-16" id="boton-decorativo-regalos">
                        <img
                            src="/imagenes/boton.png"
                            alt="Decoración"
                            class="w-full h-full object-contain"
                        />
                    </div>
                </div>

                <!-- CARD PRINCIPAL -->
                <div
                    class="relative rounded-[40px] shadow-xl overflow-hidden bg-[#f5f5f5]"
                    id="card-principal-regalos"
                    style="background-color:#8a0306; border: 2px solid #c8a24c;"
                >
                    <!-- IMAGEN DE FONDO -->
                    <img
                        src="/imagenes/fondorojo.png"
                        alt="Fondo mesa regalos"
                        class="absolute inset-0 w-full h-full object-cover opacity-90"
                    />

                    <!-- MARCO DORADO INTERIOR FINO -->
                    <div
                        class="absolute inset-2 rounded-[32px] pointer-events-none z-20"
                        style="border: 1px solid rgba(200,162,76,0.6);"
                    >
                    </div>

                    <!-- Contenido de la card -->
                    <div
                        class="relative px-4 pt-16 pb-12 z-10 flex flex-col items-center"
                    >
                        <!-- TÍTULO PRINCIPAL -->
                        <div class="text-center mb-6" id="titulo-regalos">
                            <h2
                                class="font-great-vibes text-[2.25rem] text-[#f0d38a] leading-tight"
                            >
                                Sugerencia de Regalos
                            </h2>
                        </div>

                        <!-- TEXTO DESCRIPTIVO -->
                        <div class="text-center mb-8" id="texto-regalos">
                            <p
                                class="font-cormorant text-xl text-white leading-relaxed"
                            >
                                <!-- Tu presencia es lo más importante para nosotros.
                                Por falta de espacio, se tendrán sobres
                                disponibles; si deseas tener un detalle, también
                                puedes hacerlo a través del QR. <br />
                                ¡Gracias por tu cariño! -->

                                El mejor regalo que nos puedes dar es tu
                                presencia, pero si quieres obsequiarnos algo,
                                te dejamos la dirección o código QR.
                            </p>
                        </div>

                        <!-- BANCO + QR -->
                        <div class="flex flex-col items-center mb-4" id="qr-code">
                            <p
                                class="font-cormorant text-2xl text-white font-bold tracking-widest mb-2"
                            >
                                BNB
                            </p>
                            <div class="bg-white p-3 rounded-lg">
                                <img
                                    src="/imagenes/qr.png"
                                    alt="QR Mesa de Regalos"
                                    class="w-56 h-56 object-contain"
                                />
                            </div>
                        </div>

                        <!-- DATOS DEL QR -->
                        <div id="numero-cuenta" class="text-center mb-6">
                            <p
                                class="font-cormorant text-lg text-white font-semibold tracking-wide"
                            >
                                Concepto: XV Años Laura Viviana García Castedo
                            </p>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- 🎬 ANIMACIONES CON GSAP - SOLO AL BAJAR                     -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        if (typeof window !== "undefined") {
            document.addEventListener("DOMContentLoaded", () => {
                // 🌹 ROSAS ENTRAN SUAVES DESDE LOS COSTADOS
                gsap.fromTo(
                    "#rosa-regalos-top",
                    { opacity: 0, x: -50, y: -10 },
                    {
                        opacity: 1, x: 0, y: 0,
                        duration: 1.4, ease: "power2.out", delay: 0.3,
                        scrollTrigger: { trigger: "#card-regalos", start: "top 80%", toggleActions: "play none none reset" },
                    },
                );
                gsap.fromTo(
                    "#rosa-regalos-bottom",
                    { opacity: 0, x: 50, y: 10, rotation: 180 },
                    {
                        opacity: 1, x: 0, y: 0, rotation: 180,
                        duration: 1.4, ease: "power2.out", delay: 0.5,
                        scrollTrigger: { trigger: "#card-regalos", start: "top 80%", toggleActions: "play none none reset" },
                    },
                );

                // Animación del botón decorativo
                gsap.fromTo(
                    "#boton-decorativo-regalos",
                    {
                        opacity: 0,
                        scale: 0,
                        rotation: -180,
                    },
                    {
                        opacity: 1,
                        scale: 1,
                        rotation: 0,
                        duration: 1,
                        ease: "back.out(1.7)",
                        scrollTrigger: {
                            trigger: "#card-regalos",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación de la card
                gsap.fromTo(
                    "#card-principal-regalos",
                    {
                        opacity: 0,
                        y: 50,
                        scale: 0.95,
                    },
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1,
                        ease: "power3.out",
                        scrollTrigger: {
                            trigger: "#card-regalos",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación del título
                gsap.fromTo(
                    "#titulo-regalos",
                    {
                        opacity: 0,
                        y: -20,
                    },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        ease: "power2.out",
                        scrollTrigger: {
                            trigger: "#card-regalos",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación del texto
                gsap.fromTo(
                    "#texto-regalos",
                    {
                        opacity: 0,
                        y: 20,
                    },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        delay: 0.2,
                        ease: "power2.out",
                        scrollTrigger: {
                            trigger: "#card-regalos",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación del QR
                gsap.fromTo(
                    "#qr-code",
                    {
                        opacity: 0,
                        scale: 0.8,
                    },
                    {
                        opacity: 1,
                        scale: 1,
                        duration: 0.8,
                        delay: 0.4,
                        ease: "back.out(1.7)",
                        scrollTrigger: {
                            trigger: "#card-regalos",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación del número de cuenta
                gsap.fromTo(
                    "#numero-cuenta",
                    {
                        opacity: 0,
                        y: 20,
                    },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        delay: 0.6,
                        ease: "power2.out",
                        scrollTrigger: {
                            trigger: "#card-regalos",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );

                // Animación de las direcciones
                gsap.fromTo(
                    "#direcciones",
                    {
                        opacity: 0,
                        y: 20,
                    },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        delay: 0.8,
                        ease: "power2.out",
                        scrollTrigger: {
                            trigger: "#card-regalos",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );
            });
        }
    </script>
</section>
