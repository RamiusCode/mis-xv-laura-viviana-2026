---
// Portada.astro
---

<section
    id="portada-sobre"
    class="fixed inset-0 w-full h-screen z-50 flex flex-col items-center justify-between overflow-hidden bg-white py-6 md:py-10"
>
    <!-- BLOQUE SUPERIOR -->
    <div class="flex flex-col items-center text-center z-50 px-6">
        <!-- CORONA -->
        <img
            src="/imagenes/corona.png"
            alt="Corona"
            class="h-auto drop-shadow-sm"
            style="width: clamp(80px, 14vh, 170px); margin-bottom: 3vh;"
        />

        <!-- DALE CLICK -->
        <h1
            class="font-crimson text-[#8a0306] font-bold tracking-normal uppercase leading-none"
            style="font-size: clamp(1.4rem, 4.2vh, 3rem); margin-bottom: 1vh;"
        >
            Dale Click
        </h1>
        <p
            class="font-crimson text-[#c8a24c] tracking-normal uppercase leading-snug"
            style="font-size: clamp(0.8rem, 2vh, 1.3rem);"
        >
            En el sobre para ver la
        </p>
        <p
            class="font-crimson text-[#8a0306] font-semibold tracking-normal uppercase"
            style="font-size: clamp(1rem, 2.6vh, 1.6rem); margin-bottom: 3vh;"
        >
            Invitación
        </p>

        <!-- SEPARADOR 1 -->
        <img
            src="/imagenes/separador1.png"
            alt="Separador"
            class="h-auto opacity-90"
            style="width: clamp(100px, 16vh, 200px);"
        />
    </div>

    <!-- SOLAPA IZQUIERDA DEL SOBRE -->
    <div
        id="sobre-izq"
        class="absolute left-0 top-0 w-1/2 h-full z-20 overflow-hidden"
    >
        <img
            src="/imagenes/porta.webp"
            alt="Portada Izquierda"
            class="absolute top-1/2 left-0 h-full w-auto object-cover"
            style="transform: translateY(-50%); object-position: left center;"
        />
    </div>

    <!-- SOLAPA DERECHA DEL SOBRE -->
    <div
        id="sobre-der"
        class="absolute right-0 top-0 w-1/2 h-full z-20 overflow-hidden"
    >
        <img
            src="/imagenes/porta.webp"
            alt="Portada Derecha"
            class="absolute top-1/2 right-0 h-full w-auto object-cover"
            style="transform: translateY(-50%); object-position: right center;"
        />
    </div>

    <!-- BOTÓN CENTRAL (boton.png) -->
    <div class="relative z-50 pointer-events-auto">
        <button
            id="btn-sello"
            class="relative cursor-pointer transition-all duration-300 hover:scale-110 active:scale-95 focus:outline-none"
        >
            <img
                src="/imagenes/boton.png"
                alt="Sello"
                class="h-auto"
                style="opacity: 1; width: clamp(115px, 16vh, 170px);"
            />
        </button>
    </div>

    <!-- BLOQUE INFERIOR -->
    <div class="flex flex-col items-center text-center z-50 px-6" style="margin-bottom: 4vh;">
        <!-- MIS XV AÑOS -->
        <p
            class="font-crimson text-[#8a0306] tracking-normal uppercase"
            style="font-size: clamp(1.1rem, 3vh, 1.8rem); margin-bottom: 1vh;"
        >
            Mis <span class="text-[#c8a24c] font-semibold">XV</span> Años
        </p>

        <!-- SEPARADOR 2 -->
        <img
            src="/imagenes/separador2.png"
            alt="Separador"
            class="h-auto opacity-90"
            style="width: clamp(100px, 16vh, 200px); margin-bottom: 1vh;"
        />

        <!-- NOMBRE DE LA QUINCEAÑERA -->
        <h2
            class="font-great-vibes pb-2 text-[#8a0306] leading-tight"
            style="font-size: clamp(1.6rem, 5.5vh, 3.2rem);"
        >
            Laura Viviana
        </h2>
    </div>
</section>

<script>
    import { gsap } from "gsap";

    document.addEventListener("DOMContentLoaded", () => {
        const btnSello = document.getElementById("btn-sello");
        const sobreIzq = document.getElementById("sobre-izq");
        const sobreDer = document.getElementById("sobre-der");
        const portada = document.getElementById("portada-sobre");
        const contenido = document.getElementById("contenido-revelado");

        // Animación de entrada sutil del sello (SIN cambios de opacidad)
        gsap.from("#btn-sello", {
            scale: 0.8,
            duration: 1.5,
            ease: "elastic.out(1, 0.5)",
            delay: 0.5,
        });

        // Animación de respiración del sello (SIN cambios de opacidad)
        gsap.to("#btn-sello", {
            scale: 1.05,
            duration: 2.5,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
        });

        btnSello?.addEventListener("click", () => {
            // Crear y reproducir música automáticamente
            const audio = new Audio("/musica/melodia.mp3");
            audio.loop = true;
            audio.volume = 0.5;
            audio.play().catch((error: any) => {
                console.log("Error al reproducir audio:", error);
            });

            // Guardar en window para que NombresFlores pueda controlarlo
            (window as any).audioGlobal = audio;
            (window as any).estaReproduciendoGlobal = true;

            // Actualizar iconos inmediatamente
            setTimeout(() => {
                const iconoPlay = document.getElementById("icono-play");
                const iconoPause = document.getElementById("icono-pause");

                if (iconoPlay && iconoPause) {
                    iconoPlay.classList.add("hidden");
                    iconoPause.classList.remove("hidden");
                    console.log("✅ Iconos actualizados a PAUSE");
                }
            }, 100);

            gsap.to(portada, {
                opacity: 0,
                duration: 0.8,
                ease: "power2.out",
                onStart: () => {
                    document.body.style.overflow = "auto";
                },
                onComplete: () => {
                    portada?.remove(); // Eliminar completamente del DOM
                },
            });
        });
    });
</script>

<style>
    body {
        overflow: hidden;
    }

    /* Asegurar que no haya líneas blancas entre las mitades */
    #sobre-izq,
    #sobre-der {
        margin: 0;
        padding: 0;
    }

    #sobre-izq img,
    #sobre-der img {
        margin: 0;
        padding: 0;
        display: block;
    }
</style>
