<!-- ═══════════════════════════════════════════════════════════ --><!-- 📖 SECCIÓN: CITA BÍBLICA                                    --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full py-6 sm:py-10" id="seccion-cita">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col items-center text-center" id="cita-container">
            <p
                class="font-great-vibes text-2xl sm:text-3xl md:text-4xl text-[#8a0306] leading-relaxed"
                id="cita-texto"
            >
                &ldquo;Los sueños se cumplen y hoy uno de los míos se hace realidad. Con la bendición de Dios y el amor de mi familia, te invito a celebrar mis 15 años.&rdquo;
            </p>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        gsap.fromTo(
            "#cita-texto",
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 1.4,
                ease: "sine.out",
                scrollTrigger: {
                    trigger: "#cita-container",
                    start: "top 85%",
                    toggleActions: "play none none reset",
                },
            },
        );
    });
</script>
