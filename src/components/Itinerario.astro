<!-- ═══════════════════════════════════════════════════════════ --><!-- 📅 SECCIÓN: ITINERARIO                                      --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full py-16 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- 📇 CARD DE ITINERARIO -->
        <div class="flex justify-center">
            <div class="relative w-[280px]" id="card-itinerario">
                <!-- 🌹 FLORES DECORATIVAS -->
                <img
                    src="/imagenes/rosa2.png"
                    alt="Flores"
                    class="absolute -top-8 -left-8 w-28 sm:w-32 h-auto z-30 pointer-events-none select-none drop-shadow"
                    id="rosa-itinerario-top"
                />
                <img
                    src="/imagenes/rosa2.png"
                    alt="Flores"
                    class="absolute -bottom-8 -right-8 w-28 sm:w-32 h-auto z-30 pointer-events-none select-none drop-shadow"
                    style="transform: rotate(180deg);"
                    id="rosa-itinerario-bottom"
                />

                <!-- BOTÓN DECORATIVO SUPERIOR -->
                <div
                    class="absolute z-20"
                    style="top: -30px; left: 50%; transform: translateX(-50%);"
                >
                    <div class="w-16 h-16" id="boton-decorativo-itinerario">
                        <img
                            src="/imagenes/boton.png"
                            alt="Decoración"
                            class="w-full h-full object-contain"
                        />
                    </div>
                </div>

                <!-- CARD PRINCIPAL -->
                <div
                    class="relative rounded-[40px] shadow-xl overflow-hidden bg-[#f5f5f5]"
                    id="card-principal-itinerario"
                    style="border: 2px solid #c8a24c;"
                >
                    <!-- IMAGEN DE FONDO -->
                    <img
                        src="/imagenes/fondoplomo.png"
                        alt="Fondo itinerario"
                        class="absolute inset-0 w-full h-full object-cover"
                    />

                    <!-- MARCO DORADO INTERIOR FINO -->
                    <div
                        class="absolute inset-2 rounded-[32px] pointer-events-none z-20"
                        style="border: 1px solid rgba(200,162,76,0.6);"
                    >
                    </div>

                    <!-- Contenido de la card -->
                    <div class="relative px-6 pt-16 pb-10 z-10">
                        <!-- TÍTULO PRINCIPAL -->
                        <div class="text-center mb-8">
                            <h2
                                class="font-great-vibes text-[2.25rem] leading-tight text-[#8a0306]"
                                id="titulo-itinerario"
                            >
                                Itinerario
                            </h2>
                        </div>

                        <!-- EVENTO 1: INICIO -->
                        <div class="flex items-start gap-4 mb-5" id="evento-1">
                            <div class="w-12 flex-shrink-0 mt-1">
                                <img
                                    src="/imagenes/recepcion.png"
                                    alt="Inicio"
                                    class="w-full h-auto object-contain icono-itinerario"
                                />
                            </div>
                            <div class="flex-1 text-center">
                                <h3
                                    class="font-great-vibes text-[1.75rem] text-[#8a0306] leading-none mb-1"
                                >
                                    Inicio
                                </h3>
                                <p
                                    class="font-crimson text-xl text-[#c8a24c] font-semibold"
                                >
                                    19:00
                                </p>
                            </div>
                        </div>

                        <!-- EVENTO 2: FIESTA -->
                        <div class="flex items-start gap-4 mb-5" id="evento-2">
                            <div class="w-12 flex-shrink-0 mt-1">
                                <img
                                    src="/imagenes/musica.png"
                                    alt="Fiesta"
                                    class="w-full h-auto object-contain icono-itinerario"
                                />
                            </div>
                            <div class="flex-1 text-center">
                                <h3
                                    class="font-great-vibes text-[1.75rem] text-[#8a0306] leading-none mb-1"
                                >
                                    Fiesta
                                </h3>
                                <p
                                    class="font-crimson text-xl text-[#c8a24c] font-semibold"
                                >
                                    20:00
                                </p>
                            </div>
                        </div>

                        <!-- EVENTO 3: COMIDA -->
                        <div class="flex items-start gap-4 mb-5" id="evento-3">
                            <div class="w-12 flex-shrink-0 mt-1">
                                <img
                                    src="/imagenes/ce.png"
                                    alt="Comida"
                                    class="w-full h-auto object-contain icono-itinerario"
                                />
                            </div>
                            <div class="flex-1 text-center">
                                <h3
                                    class="font-great-vibes text-[1.75rem] text-[#8a0306] leading-none mb-1"
                                >
                                    Comida
                                </h3>
                                <p
                                    class="font-crimson text-xl text-[#c8a24c] font-semibold"
                                >
                                    22:00
                                </p>
                            </div>
                        </div>

                        <!-- EVENTO 4: VALS -->
                        <div class="flex items-start gap-4 mb-5" id="evento-4">
                            <div class="w-12 flex-shrink-0 mt-1">
                                <img
                                    src="/imagenes/baile.png"
                                    alt="Vals"
                                    class="w-full h-auto object-contain icono-itinerario"
                                />
                            </div>
                            <div class="flex-1 text-center">
                                <h3
                                    class="font-great-vibes text-[1.75rem] text-[#8a0306] leading-none mb-1"
                                >
                                    Vals
                                </h3>
                                <p
                                    class="font-crimson text-xl text-[#c8a24c] font-semibold"
                                >
                                    23:00
                                </p>
                            </div>
                        </div>

                        <!-- EVENTO 5: TORTA -->
                        <div class="flex items-start gap-4 mb-5" id="evento-5">
                            <div class="w-12 flex-shrink-0 mt-1">
                                <img
                                    src="/imagenes/torta.png"
                                    alt="Torta"
                                    class="w-full h-auto object-contain icono-itinerario"
                                />
                            </div>
                            <div class="flex-1 text-center">
                                <h3
                                    class="font-great-vibes text-[1.75rem] text-[#8a0306] leading-none mb-1"
                                >
                                    Torta
                                </h3>
                                <p
                                    class="font-crimson text-xl text-[#c8a24c] font-semibold"
                                >
                                    00:00
                                </p>
                            </div>
                        </div>

                        <!-- EVENTO 6: FINALIZACIÓN -->
                        <div class="flex items-start gap-4" id="evento-6">
                            <div class="w-12 flex-shrink-0 mt-1">
                                <img
                                    src="/imagenes/despedida.png"
                                    alt="Finalización"
                                    class="w-full h-auto object-contain icono-itinerario"
                                />
                            </div>
                            <div class="flex-1 text-center">
                                <h3
                                    class="font-great-vibes text-[1.75rem] text-[#8a0306] leading-none mb-1"
                                >
                                    Finalización
                                </h3>
                                <p
                                    class="font-crimson text-xl text-[#c8a24c] font-semibold"
                                >
                                    03:00
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎨 ESTILOS PARA LOS ICONOS                                  -->
<!-- ═══════════════════════════════════════════════════════════ -->
<style>
    .icono-itinerario {
        filter: brightness(0) saturate(100%) invert(11%) sepia(89%)
            saturate(5000%) hue-rotate(354deg) brightness(75%) contrast(105%);
    }
</style>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP - SOLO UNA VEZ AL BAJAR            -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            // 🌹 ROSAS ENTRAN SUAVES DESDE LOS COSTADOS
            gsap.fromTo(
                "#rosa-itinerario-top",
                { opacity: 0, x: -50, y: -10 },
                {
                    opacity: 1, x: 0, y: 0,
                    duration: 1.4, ease: "power2.out", delay: 0.3,
                    scrollTrigger: { trigger: "#card-itinerario", start: "top 80%", toggleActions: "play none none reset" },
                },
            );
            gsap.fromTo(
                "#rosa-itinerario-bottom",
                { opacity: 0, x: 50, y: 10, rotation: 180 },
                {
                    opacity: 1, x: 0, y: 0, rotation: 180,
                    duration: 1.4, ease: "power2.out", delay: 0.5,
                    scrollTrigger: { trigger: "#card-itinerario", start: "top 80%", toggleActions: "play none none reset" },
                },
            );

            // Animación del botón decorativo
            gsap.fromTo(
                "#boton-decorativo-itinerario",
                {
                    opacity: 0,
                    scale: 0,
                    rotation: -180,
                },
                {
                    opacity: 1,
                    scale: 1,
                    rotation: 0,
                    duration: 1,
                    ease: "back.out(1.7)",
                    scrollTrigger: {
                        trigger: "#card-itinerario",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            // Animación de la card
            gsap.fromTo(
                "#card-principal-itinerario",
                {
                    opacity: 0,
                    y: 50,
                    scale: 0.95,
                },
                {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 1,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#card-itinerario",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            // Animación del título
            gsap.fromTo(
                "#titulo-itinerario",
                {
                    opacity: 0,
                    y: -20,
                },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-itinerario",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            // Animación de cada evento
            const eventos = [
                "#evento-1",
                "#evento-2",
                "#evento-3",
                "#evento-4",
                "#evento-5",
                "#evento-6",
                "#evento-7",
                "#evento-8",
            ];

            eventos.forEach((evento, index) => {
                gsap.fromTo(
                    evento,
                    {
                        opacity: 0,
                        x: -30,
                    },
                    {
                        opacity: 1,
                        x: 0,
                        duration: 0.6,
                        ease: "power2.out",
                        delay: index * 0.1,
                        scrollTrigger: {
                            trigger: "#card-itinerario",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );
            });
        });
    }
</script>
